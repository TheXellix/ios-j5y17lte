+/* j5y17lte (Exynos7870, Mali-T830): ADT /j5-gpu selects the J5 PMU/CMU layout.
+ * S-Boot leaves pd-g3d on and the G3D clocks at its own OPP, so the A5's
+ * BUCK4 and divider sequences are skipped and the inherited clock is kept. */
+static bool
+a5g3d_is_j5(uint64_t *pmuPd)
+{
+    DTEntry entry;
+    uint64_t const *reg;
+    unsigned int size;
+    if (SecureDTLookupEntry(NULL, "/j5-gpu", &entry) != kSuccess ||
+        SecureDTGetProperty(entry, "pmu-pd", (void const **)&reg, &size) != kSuccess ||
+        size < 16) {
+        return false;
+    }
+    if (pmuPd) {
+        *pmuPd = reg[0];
+    }
+    return true;
+}
