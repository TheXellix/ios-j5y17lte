diff --git a/bsd/dev/j5_gpu.c b/bsd/dev/j5_gpu.c
new file mode 100644
index 0000000..0c6d057
--- /dev/null
+++ b/bsd/dev/j5_gpu.c
@@ -0,0 +1,108 @@
+/*
+ * j5y17lte (SM-J530F, Exynos7870): Mali-T830 bring-up probe, stage 0.
+ *
+ * Only powers the G3D block and reads identification registers:
+ *   G3D power domain  PMU 0x10484000 CONFIGURATION / +4 STATUS (0xF = on),
+ *                     sequence from pwrcal S5E7870 blkpwr_g3d
+ *   G3D clocks        CMU_G3D 0x11460000: CLK_ENABLE_CLK_G3D_BUS +0x804
+ *                     bits 0-1, CLK_ENABLE_CLK_G3D_APB +0x808 bit 0;
+ *                     G3D_PLL_CON0 +0x100, MUX +0x200..0x208 logged only
+ *   GPU registers     0x11400000: GPU_ID 0x000, L2_FEATURES 0x004,
+ *                     TILER_FEATURES 0x00c, MEM_FEATURES 0x010,
+ *                     GPU_STATUS 0x034, SHADER_PRESENT 0x100,
+ *                     TILER_PRESENT 0x110, L2_PRESENT 0x120
+ * Addresses come from ADT /j5-gpu. No interrupt, MMU or job is touched.
+ * Disable with j5gpu=0.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int usec);
+void j5_gpu_probe(void);
+
+static uint32_t
+j5g_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+j5g_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static vm_offset_t
+j5g_map(DTEntry entry, const char *name)
+{
+	uint64_t const *reg;
+	unsigned int len;
+	if (SecureDTGetProperty(entry, name, (void const **)&reg, &len) != kSuccess || len < 16) {
+		return 0;
+	}
+	return ml_io_map((vm_offset_t)reg[0], (vm_size_t)reg[1]);
+}
+
+void
+j5_gpu_probe(void)
+{
+	DTEntry entry;
+	int enabled = 1;
+	vm_offset_t pd, cmu, gpu;
+	uint32_t status;
+
+	if (SecureDTLookupEntry(NULL, "/j5-gpu", &entry) != kSuccess) {
+		return;
+	}
+	(void)PE_parse_boot_argn("j5gpu", &enabled, sizeof(enabled));
+	printf("J5 GPU: Mali-T830 probe enabled=%d\n", enabled);
+	if (!enabled) {
+		return;
+	}
+	pd = j5g_map(entry, "pmu-pd");
+	cmu = j5g_map(entry, "cmu");
+	gpu = j5g_map(entry, "reg");
+	if (!pd || !cmu || !gpu) {
+		printf("J5 GPU: MMIO mapping failed\n");
+		return;
+	}
+	printf("J5 GPU: before pd cfg=%#x status=%#x; PLL_CON0=%#x mux=%#x/%#x/%#x bus=%#x apb=%#x\n",
+	    j5g_rd(pd, 0), j5g_rd(pd, 4), j5g_rd(cmu, 0x100), j5g_rd(cmu, 0x200),
+	    j5g_rd(cmu, 0x204), j5g_rd(cmu, 0x208), j5g_rd(cmu, 0x804), j5g_rd(cmu, 0x808));
+
+	if ((j5g_rd(pd, 4) & 0xfu) != 0xfu) {
+		j5g_wr(pd, 0, (j5g_rd(pd, 0) & ~0xfu) | 0xfu);
+		for (unsigned n = 0; n < 10000; n++) {
+			if ((j5g_rd(pd, 4) & 0xfu) == 0xfu) {
+				break;
+			}
+			delay(1);
+		}
+	}
+	status = j5g_rd(pd, 4);
+	printf("J5 GPU: power domain status=%#x (%s)\n", status,
+	    (status & 0xfu) == 0xfu ? "on" : "NOT ON");
+	if ((status & 0xfu) != 0xfu) {
+		return;
+	}
+	j5g_wr(cmu, 0x804, j5g_rd(cmu, 0x804) | 0x3u);
+	j5g_wr(cmu, 0x808, j5g_rd(cmu, 0x808) | 0x1u);
+	delay(100);
+	printf("J5 GPU: clocks bus=%#x apb=%#x\n", j5g_rd(cmu, 0x804), j5g_rd(cmu, 0x808));
+
+	uint32_t id = j5g_rd(gpu, 0x000);
+	printf("J5 GPU: GPU_ID=%#x (product %#x r%up%u) L2_FEATURES=%#x TILER_FEATURES=%#x MEM_FEATURES=%#x\n",
+	    id, id >> 16, (id >> 12) & 0xfu, (id >> 4) & 0xffu,
+	    j5g_rd(gpu, 0x004), j5g_rd(gpu, 0x00c), j5g_rd(gpu, 0x010));
+	printf("J5 GPU: GPU_STATUS=%#x SHADER_PRESENT=%#x TILER_PRESENT=%#x L2_PRESENT=%#x\n",
+	    j5g_rd(gpu, 0x034), j5g_rd(gpu, 0x100), j5g_rd(gpu, 0x110), j5g_rd(gpu, 0x120));
+}
+#endif
