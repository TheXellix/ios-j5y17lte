 	}
 }
 
+/* j5y17lte: eMMC throughput every 30 s in the console / RAM log (j5emmcstats=0 off). */
+static int j5_emmc_stats_sleep;
+static void
+j5_emmc_stats_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	uint64_t prev_rb = 0, prev_active = 0, prev_req = 0;
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(30, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&j5_emmc_stats_sleep, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		uint64_t rb = emmc_read_bytes, active = emmc_active_ns, req = emmc_requests;
+		uint64_t d_ms = (active - prev_active) / 1000000u;
+		printf("J5 eMMC: 30s read=%llu KiB requests=%llu busy=%llu ms (%llu KiB/s while busy); "
+		    "total read=%llu MiB busy=%llu s wait=%llu s max_req=%llu ms retries=%u\n",
+		    (rb - prev_rb) / 1024u, req - prev_req, d_ms,
+		    d_ms ? (rb - prev_rb) / 1024u * 1000u / d_ms : 0,
+		    rb >> 20, active / 1000000000u, emmc_lock_wait_ns / 1000000000u,
+		    emmc_max_request_ns / 1000000u, emmc_read_retries);
+		prev_rb = rb;
+		prev_active = active;
+		prev_req = req;
+	}
+}
+
+static void
+j5_emmc_stats_start(void)
+{
+	static bool started;
+	int enabled = 1;
+	thread_t thread;
+	(void)PE_parse_boot_argn("j5emmcstats", &enabled, sizeof(enabled));
+	if (started || !enabled || !emmc_ready) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(j5_emmc_stats_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 static void
 emmc_log_start(void)
 {
+	j5_emmc_stats_start();
 	int enabled = 0;
 	thread_t thread;
 	(void)PE_parse_boot_argn("a5log", &enabled, sizeof(enabled));
