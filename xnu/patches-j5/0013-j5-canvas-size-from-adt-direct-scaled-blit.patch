 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/*
+ * Nearest-neighbour blit of one presented layer, logical canvas coordinates
+ * (dx, dy, w, h) -> panel pixels, reading the layer directly. Replaces the
+ * former copy into the uncached canvas followed by a whole-canvas rescale.
+ */
+void
+AppleCLCD::j5BlitScaled(uintptr_t src, uint32_t srcRowBytes, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	static uint16_t pxmap[2048];
+	static uint32_t pmapped_w, pmapped_src_w;
+	if (fJ5W > 2048 || fJ5W == 0 || fJ5H == 0 || w <= 0 || h <= 0) {
+		return;
+	}
+	if (pmapped_w != fJ5W || pmapped_src_w != fWidth) {
+		for (uint32_t x = 0; x < fJ5W; x++) {
+			pxmap[x] = (uint16_t)((uint64_t)x * fWidth / fJ5W);
+		}
+		pmapped_w = fJ5W;
+		pmapped_src_w = fWidth;
+	}
+	uint32_t py0 = (uint32_t)((uint64_t)dy * fJ5H / fHeight);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fJ5H + fHeight - 1) / fHeight);
+	uint32_t px0 = (uint32_t)((uint64_t)dx * fJ5W / fWidth);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fJ5W + fWidth - 1) / fWidth);
+	if (py1 > fJ5H) {
+		py1 = fJ5H;
+	}
+	if (px1 > fJ5W) {
+		px1 = fJ5W;
+	}
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)((uint64_t)py * fHeight / fJ5H);
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		const uint32_t *row = (const uint32_t *)(src + (uint64_t)(sy + ly - dy) * srcRowBytes) + sx - dx;
+		uint32_t *dst = (uint32_t *)(fJ5Panel + (uint64_t)py * fJ5Stride);
+		for (uint32_t px = px0; px < px1; px++) {
+			int32_t lx = pxmap[px];
+			if (lx >= dx && lx < dx + w) {
+				dst[px] = row[lx];
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
