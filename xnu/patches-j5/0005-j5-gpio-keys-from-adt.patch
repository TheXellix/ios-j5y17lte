+/*
+ * j5y17lte: the keys sit in three ALIVE banks (GPA0/GPA1/GPA2). ADT
+ * /j5-keys: reg = <pinctrl base, size>, keys = 4 x <DAT offset, bit> in the
+ * sweet_hid_key order power, volume up, volume down, home (active low).
+ * Without the node the A5 GPA2 layout below is used unchanged.
+ */
+static uint32_t j5_key_off[4], j5_key_bit[4];
+static bool j5_keys;
+
+/* One bit per sweet_hid_key index, 1 = released (active-low pins). */
+static uint8_t
+j5_keys_sample(void)
+{
+	uint8_t v = 0;
+	for (unsigned k = 0; k < 4; k++) {
+		uint32_t dat = *(volatile uint32_t *)(a5_alive + j5_key_off[k]);
+		if (dat & (1u << j5_key_bit[k])) {
+			v |= (uint8_t)(1u << k);
+		}
+	}
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
