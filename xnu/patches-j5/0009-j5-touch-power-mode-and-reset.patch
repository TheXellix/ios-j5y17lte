 #define IST_IDLE_MSG         0x8ead8eadu    /* firmware not scanning */
 #define IST_CMD_FW_START     0x01u
 #define IST_CMD_MODE_SPECIAL 0x22u
+#define IST_NOISE_MODE_POWER (1u << 8)    /* Linux ist30xx_resume(): display on */
 
 static vm_offset_t j5t_i2c, j5t_hsi, j5t_alive;
 static uint32_t j5t_max_x = 720, j5t_max_y = 1280, j5t_flags;
@@ -324,16 +325,36 @@ j5t_ist_write(uint32_t reg, uint32_t value)
 	return ok;
 }
 
-/* Linux ist30xx_start(): normal (non-TA) noise mode, then FW_START. */
+/* Linux ist30xx_resume() -> ist30xx_start(): noise_mode with the POWER bit
+ * (display on), then FW_START. Without POWER the firmware stays idle. */
 static bool
 j5t_ist_start_scan(void)
 {
-	bool a = j5t_ist_write(IST_HIB_CMD, IST_CMD_MODE_SPECIAL << 16);
+	bool a = j5t_ist_write(IST_HIB_CMD, (IST_CMD_MODE_SPECIAL << 16) | IST_NOISE_MODE_POWER);
 	bool b = j5t_ist_write(IST_HIB_CMD, (IST_CMD_FW_START << 16) | 1u);
 	printf("J5 TOUCH: start scan mode=%d fw_start=%d\n", a, b);
 	return a && b;
 }
 
+/* Linux ist30xx_reset(): avdd off, 50 + 10 ms, avdd on, 60 ms. */
+static bool
+j5t_ist_power_cycle(void)
+{
+	uint8_t ldo = 0;
+	if (!j5t_pmic_read(J5T_LDO34, &ldo) || (ldo & 0x3fu) != 0x3cu) {
+		return false;
+	}
+	if (!j5t_pmic_write(J5T_LDO34, ldo & ~0xc0u)) {
+		return false;
+	}
+	delay(60000);
+	if (!j5t_pmic_write(J5T_LDO34, (ldo & 0x3fu) | 0xc0u)) {
+		return false;
+	}
+	delay(60000);
+	return true;
+}
