+/*
+ * j5y17lte: Exynos7870 reports occasional HTO (data starvation by host
+ * timeout, RINTSTS bit 10) on polled CMD17 when the reading thread is
+ * delayed before it drains the FIFO. The sector is intact on the card: reset
+ * the FIFO and reissue the command instead of failing the page-in, which
+ * otherwise reaches user space as SIGBUS (KERN_MEMORY_ERROR).
+ */
+static unsigned int emmc_read_retries, emmc_read_recovered;
+
+static int
+emmc_read_sector(uint32_t lba, uint8_t *sector)
+{
+	int error = 0;
+	for (unsigned int attempt = 0; attempt < 8; attempt++) {
+		error = emmc_read_sector_once(lba, sector);
+		if (error != EIO && error != ETIMEDOUT) {
+			if (attempt != 0 && error == 0) {
+				emmc_read_recovered++;
+				printf("A5XELTE eMMC: CMD17 lba=%u recovered after %u retries (total %u/%u)\n",
+				    lba, attempt, emmc_read_recovered, emmc_read_retries);
+			}
+			return error;
+		}
+		emmc_read_retries++;
+		delay(50 * (attempt + 1));
+	}
+	printf("A5XELTE eMMC: CMD17 lba=%u failed after retries, error %d\n", lba, error);
+	return error;
+}
