+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+/* Nearest-neighbour 1080x1920 -> 720x1280 (or any smaller panel). */
+void
+AppleCLCD::j5ScaleToPanel()
+{
+	static uint16_t xmap[2048];
+	static uint32_t mapped_w, mapped_src_w;
+	if (fJ5W > 2048 || fJ5W == 0 || fJ5H == 0) {
+		return;
+	}
+	if (mapped_w != fJ5W || mapped_src_w != fWidth) {
+		for (uint32_t x = 0; x < fJ5W; x++) {
+			xmap[x] = (uint16_t)((uint64_t)x * fWidth / fJ5W);
+		}
+		mapped_w = fJ5W;
+		mapped_src_w = fWidth;
+	}
+	for (uint32_t y = 0; y < fJ5H; y++) {
+		const uint32_t *src = (const uint32_t *)(fPixels +
+		    ((uint64_t)y * fHeight / fJ5H) * fRowBytes);
+		uint32_t *dst = (uint32_t *)(fJ5Panel + (uint64_t)y * fJ5Stride);
+		for (uint32_t x = 0; x < fJ5W; x++) {
+			dst[x] = src[xmap[x]];
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+#endif
