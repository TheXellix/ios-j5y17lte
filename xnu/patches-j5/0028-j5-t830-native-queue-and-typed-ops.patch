+/* v5 MFBD + one render target (word layout from runtime_fb_v5.h packing):
+ * [1] WLS, [8] size-1, [9]/[10] bound min/max, [11]/[12] tile setup,
+ * [14] polygon list size, [15] hierarchy mask, [16..23] list/body/heap,
+ * RT [32] internal format, [33] writeback, [34] preload, [40] base,
+ * [42]/[43] stride, [44..47] clear colour or preload buffer (union). */
+static void encode_framebuffer_t830(uint8_t *out, uint64_t desc_va,
+    const struct a5_midgard_image *dst, const struct a5_midgard_rect *bounds,
+    uint32_t clear_color, int preload)
+{
+    const size_t fb = 0x100;
+    put32(out, fb + 1 * 4, 31);
+    put32(out, fb + 8 * 4, ((dst->height - 1) << 16) | (dst->width - 1));
+    put32(out, fb + 9 * 4, (bounds->y << 16) | bounds->x);
+    put32(out, fb + 10 * 4, ((bounds->y + bounds->height - 1) << 16) |
+        (bounds->x + bounds->width - 1));
+    put32(out, fb + 11 * 4, 0x01001080u);   /* tie-break, 16x16 tiles, 1 RT */
+    put32(out, fb + 12 * 4, 0x00010000u);   /* 1 KiB colour buffer per tile */
+    if (preload) {
+        const uint32_t bins_x = (dst->width + 1023) / 1024;
+        const uint32_t bins_y = (dst->height + 1023) / 1024;
+        put32(out, fb + 14 * 4, 0x200 + bins_x * bins_y * 0x200);
+        put32(out, fb + 15 * 4, 0x01c7);    /* 1024x1024 flat bins */
+    } else {
+        put32(out, fb + 14 * 4, 0x204);     /* no geometry, 512+4 bytes */
+        put32(out, fb + 15 * 4, 0x0fff);    /* user (no hierarchy) */
+    }
+    put64(out, fb + 16 * 4, desc_va + 0x1000);
+    put64(out, fb + 18 * 4, desc_va + 0x1200);
+    put64(out, fb + 20 * 4, desc_va + (preload ? A5_MIDGARD_HEAP_OFFSET : 0x1000));
+    put64(out, fb + 22 * 4, desc_va + (preload ?
+        A5_MIDGARD_HEAP_OFFSET + A5_MIDGARD_HEAP_BYTES : 0x1000));
+    put32(out, fb + 32 * 4, 0x04000000u);   /* RGBA8 internal format */
+    put32(out, fb + 33 * 4, 0x86888899u);   /* write, RGBA8 linear, dither, 0x688, clean */
+    put64(out, fb + 40 * 4, dst->gpu_va);
+    put32(out, fb + 42 * 4, dst->row_bytes);
+    put32(out, fb + 43 * 4, dst->row_bytes * dst->height);
+    if (preload) {
+        put32(out, fb + 34 * 4, 0x00000899u); /* preload RGBA8 linear */
+        put64(out, fb + 44 * 4, dst->gpu_va);
+        put32(out, fb + 46 * 4, dst->row_bytes);
+        put32(out, fb + 47 * 4, dst->row_bytes * dst->height);
+    } else {
+        for (unsigned i = 0; i < 4; ++i)
+            put32(out, fb + (44 + i) * 4, clear_color);
+    }
+    put32(out, 0x1200, 0xa0000000u);   /* empty polygon-list body */
+}
