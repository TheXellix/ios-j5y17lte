+/* 4-byte register address + 4-byte value, one write message (Linux
+ * ist30xx_write_cmd), then the driver's 40 ms settle time. */
+static bool
+j5t_ist_write(uint32_t reg, uint32_t value)
+{
+	uint8_t a[8] = {(uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		(uint8_t)(value >> 24), (uint8_t)(value >> 16), (uint8_t)(value >> 8), (uint8_t)value};
+	bool ok = false;
+
+	for (unsigned n = 0; n < 5000 && (j5t_rd(j5t_i2c, IICSTAT) & 0x20u); n++) {
+		delay(1);
+	}
+	if (j5t_i2c_start(0xd0u, J5T_SLAVE << 1)) {
+		ok = true;
+		for (unsigned i = 0; i < 8 && ok; i++) {
+			j5t_wr(j5t_i2c, IICDS, a[i]);
+			delay(1);
+			j5t_i2c_clear();
+			ok = j5t_i2c_wait() && !(j5t_rd(j5t_i2c, IICSTAT) & 1u);
+		}
+	}
+	j5t_i2c_stop();
+	delay(40000);
+	return ok;
+}
+
+/* Linux ist30xx_start(): normal (non-TA) noise mode, then FW_START. */
+static bool
+j5t_ist_start_scan(void)
+{
+	bool a = j5t_ist_write(IST_HIB_CMD, IST_CMD_MODE_SPECIAL << 16);
+	bool b = j5t_ist_write(IST_HIB_CMD, (IST_CMD_FW_START << 16) | 1u);
+	printf("J5 TOUCH: start scan mode=%d fw_start=%d\n", a, b);
+	return a && b;
+}
