diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index ed7dccd..5782170 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -810,6 +810,93 @@ SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) sweet_fbcon_serial_fu
 	.device = SERIAL_SWEET_FBCON
 };
 
+#if defined(A5XELTE)
+/*
+ * j5y17lte: mirror the console into the Samsung exynos-snapshot log_kernel
+ * ring (ADT /j5-ramlog, normally 0x46800000). The J5 loader stores
+ * SEC_LKMSG_MAGICKEY in the ring's last 8 bytes, so after any reset TWRP's
+ * /proc/last_kmsg returns the whole ring including this text. Uncached
+ * device mapping: nothing to flush before a watchdog or panic reset.
+ * Disable with j5ramlog=0.
+ */
+static volatile uint8_t *j5rl_base;
+static uint32_t j5rl_size, j5rl_pos;
+
+static void
+j5rl_init(void)
+{
+}
+
+static unsigned int
+j5rl_transmit_ready(void)
+{
+	return 1;
+}
+
+static void
+j5rl_transmit_data(uint8_t c)
+{
+	if (j5rl_base == NULL) {
+		return;
+	}
+	j5rl_base[j5rl_pos] = c;
+	if (++j5rl_pos >= j5rl_size) {
+		j5rl_pos = 64;  /* keep the header line */
+	}
+}
+
+static unsigned int
+j5rl_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+j5rl_receive_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) j5_ramlog_serial_functions =
+{
+	.init = j5rl_init,
+	.transmit_ready = j5rl_transmit_ready,
+	.transmit_data = j5rl_transmit_data,
+	.receive_ready = j5rl_receive_ready,
+	.receive_data = j5rl_receive_data,
+	.device = SERIAL_J5_RAMLOG
+};
+
+static void
+j5_ramlog_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+	int enabled = 1;
+
+	(void)PE_parse_boot_argn("j5ramlog", &enabled, sizeof(enabled));
+	if (!enabled ||
+	    SecureDTFindEntry("name", "j5-ramlog", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 16 || reg[1] < 4096 || reg[1] > (8u << 20)) {
+		return;
+	}
+	j5rl_base = (volatile uint8_t *)ml_io_map(reg[0], reg[1]);
+	if (j5rl_base == NULL) {
+		return;
+	}
+	j5rl_size = (uint32_t)reg[1];
+	static const char header[64] = "\nJ5XNULOG ring start (XNU console, j5y17lte)\n";
+	for (uint32_t i = 0; i < sizeof(header); i++) {
+		j5rl_base[i] = (uint8_t)header[i];
+	}
+	j5rl_pos = sizeof(header);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	register_serial_functions(&j5_ramlog_serial_functions);
+}
+#endif /* A5XELTE */
+
 static void
 fbcon_probe(void)
 {
@@ -927,6 +1014,9 @@ serial_init(void)
 	PE_parse_boot_argn("disable-uart-irq", &disable_uart_irq, sizeof(disable_uart_irq));
 
 	fbcon_probe();
+#if defined(A5XELTE)
+	j5_ramlog_probe();
+#endif
 
 #ifdef PI3_UART
 	if (SecureDTFindEntry("name", "gpio", &entryP) == kSuccess) {
