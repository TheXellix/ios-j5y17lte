+	{
+		uint32_t chip = 0;
+		bool c = j5t_ist_read(0x40001000u | 0x80000000u, &chip);   /* DA CHIPID */
+		printf("J5 TOUCH: chip id read=%d value=%#x GPA0 con=%#x dat=%#x\n",
