index ef9304e..24687e1 100644
--- a/iokit/Kernel/arm/A5XELTEGPU.cpp
+++ b/iokit/Kernel/arm/A5XELTEGPU.cpp
@@ -222,6 +222,21 @@ j5_quirks:
         service->setProperty("A5G3DJobResult", "t720-shader-quirk-readback-failed");
         return false;
     }
+    /* j5y17lte: report the inherited JM/shader/tiler/L2_MMU configuration.
+     * Panfrost and kbase clear the L2_MMU_CONFIG external read/write
+     * outstanding-transaction limits (2-bit fields at 24/26, 3-bit at 23/26)
+     * on Midgard; j5l2mmufix=1 does the same here. */
+    {
+        const uint32_t mmuOld = a5g3d_read32(gpu, 0xf0c);
+        uint32_t fix = 0;
+        if (PE_parse_boot_argn("j5l2mmufix", &fix, sizeof(fix)) && fix == 1) {
+            a5g3d_write32(gpu, 0xf0c, mmuOld & ~((7u << 23) | (7u << 26)));
+            __sync_synchronize();
+        }
+        IOLog("A5XELTE G3D: config jm=%08x shader=%08x tiler=%08x l2_mmu=%08x -> %08x (fix=%u)\n",
+            a5g3d_read32(gpu, 0xf00), a5g3d_read32(gpu, 0xf04), a5g3d_read32(gpu, 0xf08),
+            mmuOld, a5g3d_read32(gpu, 0xf0c), fix);
+    }
     /* Match panfrost_gpu_power_on: L2, shader, then tiler. The domain
      * and CMU gates were verified in a5g3d_probe_existing_power().
      */
