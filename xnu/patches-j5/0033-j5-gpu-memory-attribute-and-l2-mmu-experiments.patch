@@ -52,7 +52,35 @@ enum {
 bool a5g3d_is_t830(void);
 static inline uint32_t a5g3d_as1_product(void) { return a5g3d_is_t830() ? 0x830u : 0x720u; }
 
-static const uint64_t kAS1PageDescriptor = 0x2c1ULL;
+/* j5y17lte: j5as1attr=N (0..7) selects the MEMATTR index of AS1 leaf
+ * entries (bits 4:2) for GPU memory-attribute experiments; default 0. */
+static uint64_t
+a5g3d_as1_page_descriptor(void)
+{
+    static uint64_t cached;
+    if (!cached) {
+        uint32_t index = 0;
+        if (!PE_parse_boot_argn("j5as1attr", &index, sizeof(index)) || index > 7)
+            index = 0;
+        cached = 0x2c1ULL | ((uint64_t)index << 2);
+    }
+    return cached;
+}
+#define kAS1PageDescriptor a5g3d_as1_page_descriptor()
+/* j5as1memattr=0xHHHHHHHH replaces the low MEMATTR word (indices 0..3). */
+static uint32_t
+a5g3d_as1_memattr(void)
+{
+    static uint32_t cached;
+    if (!cached) {
+        uint32_t value = 0;
+        cached = PE_parse_boot_argn("j5as1memattr", &value, sizeof(value)) && value ?
+            value : 0x888d88u;
+        IOLog("A5XELTE G3D AS1: memattr=%08x pte=%llx\n", cached,
+            (unsigned long long)a5g3d_as1_page_descriptor());
+    }
+    return cached;
+}
