@@ -479,6 +496,7 @@ j5_touch_probe(void)
 	j5t_wr(nfc_pins, 0, (j5t_rd(nfc_pins, 0) & ~0xffu) | 0x22u);
 	j5t_wr(nfc_pins, 8, j5t_rd(nfc_pins, 8) & ~0xfu);
 	delay(100);
+	j5t_i2c_setup();
 	printf("J5 TOUCH: I2C2 con=%#x stat=%#x lc=%#x\n",
 	    j5t_rd(j5t_i2c, IICCON), j5t_rd(j5t_i2c, IICSTAT), j5t_rd(j5t_i2c, IICLC));
 
