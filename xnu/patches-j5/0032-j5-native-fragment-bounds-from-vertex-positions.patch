+/* j5y17lte: shrink the fragment job to the tiles the draw can touch. The
+ * vertex job has written screen-space float4 positions (Midgard lowers the
+ * viewport transform into the vertex shader). Tiles outside the rectangle
+ * get no primitive from this draw, so preload+writeback there would only
+ * rewrite unchanged pixels. Any non-finite or unusual position keeps the
+ * original bounds. Returns false only on a cache maintenance error. */
+static bool a5g3d_as1_native_shrink(A5G3DAS1Context *ctx,const A5NativeSubmitRequest &r)
+{
+    if (!r.reserved) return true;
+    const uint32_t count=(r.reserved>>12)&2047u,offset=(r.reserved&4095u)<<6;
+    if (ctx->jobs->performOperation(kIOMemoryIncoherentIOFlush,offset,count*16u)!=kIOReturnSuccess)
+        return false;
+    uint8_t *job=static_cast<uint8_t *>(ctx->jobs->getBytesNoCopy());
+    /* No FPU in -mkernel code: floor() of each IEEE-754 binary32 by bits. */
+    const uint32_t *p=reinterpret_cast<const uint32_t *>(job+offset);
+    int minX=0x7fffffff,minY=0x7fffffff,maxX=-0x7fffffff-1,maxY=-0x7fffffff-1;
+    for (uint32_t i=0;i<count;i++) {
+        int v[2];
+        for (uint32_t c=0;c<2;c++) {
+            const uint32_t b=p[i*4+c];
+            const int e=(int)((b>>23)&255u)-127;
+            if (e>=14) return true;          /* |x|>=16384, Inf or NaN */
+            if (!(b&0x7fffffffu)) { v[c]=0; continue; }
+            if (e<0) { v[c]=(b>>31)?-1:0; continue; }
+            const uint32_t m=(b&0x7fffffu)|0x800000u,sh=23u-(uint32_t)e;
+            const int ip=(int)(m>>sh);const bool frac=(m&((1u<<sh)-1u))!=0;
+            v[c]=(b>>31)?-ip-(frac?1:0):ip;
+        }
+        if (v[0]<minX) minX=v[0]; if (v[0]>maxX) maxX=v[0];
+        if (v[1]<minY) minY=v[1]; if (v[1]>maxY) maxY=v[1];
+    }
+    uint32_t *payload=reinterpret_cast<uint32_t *>(job+r.fragmentOffset+32);
+    const uint32_t w0=payload[0],w1=payload[1];
+    int bx0=(int)(w0&0xfffu),by0=(int)((w0>>16)&0xfffu),bx1=(int)(w1&0xfffu),by1=(int)((w1>>16)&0xfffu);
+    /* One pixel of margin for rasterisation rules, then whole 16x16 tiles. */
+    int tx0=(minX-1)>>4,ty0=(minY-1)>>4,tx1=(maxX+1)>>4,ty1=(maxY+1)>>4;
+    if (tx0<bx0) tx0=bx0; if (ty0<by0) ty0=by0;
+    if (tx1>bx1) tx1=bx1; if (ty1>by1) ty1=by1;
+    /* Entirely outside: keep one tile of the original bounds (no-op work). */
+    if (tx0>tx1 || ty0>ty1) { tx0=tx1=bx0; ty0=ty1=by0; }
+    static unsigned reports=0;
+    if (++reports<=16 || !(reports&255))
+        IOLog("A5XELTE G3D native bounds: count=%u tiles %d,%d..%d,%d -> %d,%d..%d,%d\n",
+            count,bx0,by0,bx1,by1,tx0,ty0,tx1,ty1);
+    if (tx0==bx0 && ty0==by0 && tx1==bx1 && ty1==by1) return true;
+    payload[0]=(w0&~0x0fff0fffu)|(uint32_t)tx0|((uint32_t)ty0<<16);
+    payload[1]=(w1&~0x0fff0fffu)|(uint32_t)tx1|((uint32_t)ty1<<16);
+    __sync_synchronize();
+    return ctx->jobs->performOperation(kIOMemoryIncoherentIOStore,
+        r.fragmentOffset+32,8)==kIOReturnSuccess;
+}
