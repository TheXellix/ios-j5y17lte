+        static const struct { uint16_t offset; uint32_t word; } fixture830[] = {
+#include "A5XELTEGPUTextureFixtureT830.inc"
+        };
+        for (const auto &entry : fixture830)
+            *reinterpret_cast<uint32_t *>(data + entry.offset) = entry.word;
+        uint32_t *source = reinterpret_cast<uint32_t *>(data + 0xa00);
