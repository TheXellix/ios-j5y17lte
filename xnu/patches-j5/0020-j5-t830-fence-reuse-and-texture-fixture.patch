+        reinterpret_cast<uint64_t *>(fb)[10] = kA5G3DTestVA + 0x3000;
+        reinterpret_cast<uint64_t *>(fb)[11] = kA5G3DTestVA + 0x4000;
+        fb[32] = 1u << 26;
